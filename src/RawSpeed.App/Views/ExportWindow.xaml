<Window x:Class="RawSpeed.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RawSpeed.App.Models"
        Title="导出照片" Width="650" Height="780" MinWidth="570" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#151A20" Foreground="#E7EBEF"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#A6B2BE" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" /><Setter Property="Margin" Value="0,20,0,12" /></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="Foreground" Value="#17202A" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E7EBEF" /><Setter Property="Margin" Value="0,10,16,0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0F141B" /><Setter Property="Foreground" Value="#E7EBEF" /><Setter Property="BorderBrush" Value="#3B4652" /><Setter Property="Padding" Value="8,6" /><Setter Property="CaretBrush" Value="White" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="18,9" /><Setter Property="Margin" Value="10,0,0,0" /><Setter Property="MinWidth" Value="88" /></Style>
  </Window.Resources>
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="导出照片" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SourceDescription}" Foreground="#A6B2BE" Margin="0,7,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,14,10">
        <TextBlock Text="文件与编码" Style="{StaticResource Section}" Margin="0,0,0,12" />
        <ComboBox x:Name="FormatBox" ItemsSource="{x:Static models:ExportDialogModel.Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Format}" AutomationProperties.Name="导出格式" />
        <StackPanel Visibility="{Binding IsJpeg, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
          <DockPanel><TextBlock Text="品质  1–100" VerticalAlignment="Center" /><TextBox Text="{Binding QualityText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Right" AutomationProperties.Name="JPEG品质" /></DockPanel>
          <WrapPanel><CheckBox Content="渐进式 JPEG" IsChecked="{Binding JpegProgressive}" /><CheckBox Content="优化编码" IsChecked="{Binding JpegOptimize}" /></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsPng, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
          <DockPanel><TextBlock Text="压缩级别  0–9" VerticalAlignment="Center" /><TextBox Text="{Binding PngCompressionText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Right" AutomationProperties.Name="PNG压缩级别" /></DockPanel>
          <TextBlock Text="所有级别均为无损。2 适合快速导出；较高数值更慢、文件可能更小。" Foreground="#A6B2BE" Margin="0,7,0,0" />
        </StackPanel>
        <ComboBox ItemsSource="{x:Static models:ExportDialogModel.TiffCompressions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TiffCompression}" Visibility="{Binding IsTiff, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0" AutomationProperties.Name="TIFF压缩" />

        <TextBlock Text="图像尺寸" Style="{StaticResource Section}" />
        <ComboBox ItemsSource="{x:Static models:ExportDialogModel.ResizeModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ResizeMode}" AutomationProperties.Name="尺寸模式" />
        <StackPanel Visibility="{Binding ShowsLongEdge, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
          <TextBlock Text="长边（px）" Style="{StaticResource Caption}" /><TextBox Text="{Binding LongEdgeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="长边像素" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowsDimensions, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="宽度（px）" Style="{StaticResource Caption}" /><TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输出宽度" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="高度（px）" Style="{StaticResource Caption}" /><TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输出高度" /></StackPanel>
          </Grid>
          <CheckBox Content="保持比例（适合指定宽高范围）" IsChecked="{Binding PreserveAspectRatio}" />
        </StackPanel>
        <CheckBox Content="允许放大" IsChecked="{Binding AllowUpscale}" ToolTip="默认不放大；实际输出尺寸显示在底部。" />
        <DockPanel Margin="0,12,0,0"><TextBlock Text="打印分辨率  DPI" VerticalAlignment="Center" /><TextBox Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Right" AutomationProperties.Name="打印DPI" /></DockPanel>

        <TextBlock Text="色彩与拍摄信息" Style="{StaticResource Section}" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="转换到色彩空间" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{x:Static models:ExportDialogModel.ColorProfiles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColorProfile}" AutomationProperties.Name="输出色彩空间" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="位深" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{x:Static models:ExportDialogModel.BitDepths}" SelectedItem="{Binding BitDepth}" IsEnabled="{Binding SupportsHighBitDepth}" AutomationProperties.Name="输出位深" /></StackPanel>
        </Grid>
        <TextBlock Text="当前编辑结果为 8 位。16 位文件用于交换，不会恢复原始 RAW 的额外精度。" Foreground="#A6B2BE" Margin="0,9,0,12" />
        <ComboBox ItemsSource="{x:Static models:ExportDialogModel.MetadataModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MetadataMode}" IsEnabled="{Binding HasMetadataSource}" AutomationProperties.Name="拍摄信息保留" />
        <TextBlock Text="仅保留标准相机、镜头、曝光、拍摄日期及作者字段；不复制旧缩略图、厂商私有字段和编辑历史。GPS 位置需要单独选择。" Foreground="#A6B2BE" Margin="0,9,0,0" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <Border Background="#222C25" Padding="12,10" CornerRadius="5">
        <StackPanel><TextBlock Text="{Binding OutputSummary}" Foreground="#C8F28A" FontWeight="SemiBold" /><TextBlock Text="{Binding PrintSize}" Foreground="#A6B2BE" FontSize="11" Margin="0,5,0,0" /></StackPanel>
      </Border>
      <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFAD94" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ActionError" Foreground="#FFAD94" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="取消" IsCancel="True" />
        <Button Content="选择位置并导出…" IsDefault="True" IsEnabled="{Binding CanExport}" Click="Export_Click" Background="#C8F28A" Foreground="#17220F" AutomationProperties.Name="选择位置并导出" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
