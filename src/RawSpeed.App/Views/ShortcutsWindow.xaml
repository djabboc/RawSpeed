<Window x:Class="RawSpeed.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键与鼠标" Width="700" Height="730" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#151A20" Foreground="#E7EBEF" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="快捷键与鼠标" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="直接编辑组合键，多个方式用分号分隔；留空可停用。" Foreground="#A6B2BE" Margin="0,10,0,6" TextWrapping="Wrap" />
      <TextBlock Text="例如 Ctrl+O、Shift+B、WheelUp、Ctrl+WheelDown。数字用 D0–D9；小键盘 + / − 用 Add / Subtract。Esc 保留用于退出当前工具。" Foreground="#A6B2BE" TextWrapping="Wrap" />
    </StackPanel>
    <DataGrid x:Name="BindingsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
              Background="#202730" Foreground="#E7EBEF" RowBackground="#202730" AlternatingRowBackground="#252E39"
              BorderBrush="#3B4652" HorizontalGridLinesBrush="#3B4652" SelectionUnit="Cell" RowHeight="37">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#33404D" /><Setter Property="Foreground" Value="#E7EBEF" /><Setter Property="Padding" Value="10,8" /></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#17202A" /><Setter Property="Background" Value="White" /></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="操作" Binding="{Binding Label}" IsReadOnly="True" Width="170" />
        <DataGridTextColumn Header="键盘 / 鼠标组合" Binding="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="ValidationError" Grid.Row="2" Foreground="#FFAD94" TextWrapping="Wrap" MinHeight="24" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite" />
    <Grid Grid.Row="3"><Button Content="恢复默认" Click="Reset_Click" HorizontalAlignment="Left" Padding="14,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,10,0" />
        <Button x:Name="SaveButton" Content="保存快捷键" IsDefault="True" Click="Save_Click" Padding="18,8" Background="#C8F28A" Foreground="#17220F" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
