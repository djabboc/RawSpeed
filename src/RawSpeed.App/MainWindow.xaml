<Window x:Class="RawSpeed.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RawSpeed.App.Controls"
        Style="{StaticResource {x:Type Window}}" Title="RawSpeed · RAW 照片工作室"
        Width="1480" Height="960" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="OnFilesDrop" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Surface}" Padding="20,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Accent}" Width="30" Height="30" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="R" Foreground="#17220E" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="RAWSPEED" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="让照片，回到创作本身。" Foreground="{StaticResource Muted}" FontSize="10" />
                    </StackPanel>
                    <TextBlock Text="0.2" Foreground="{StaticResource Muted}" Margin="16,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="快捷键" Click="ConfigureShortcuts" />
                    <Button Content="打开照片" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="OpenPhotos" />
                    <Button Content="保存配方" Command="{Binding SaveCommand}" />
                    <Button Content="导出照片  ↗" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ExportPhoto" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="210" MinWidth="150" MaxWidth="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="ToolsColumn" Width="360" MinWidth="300" MaxWidth="650" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface}" Padding="12,16,12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="照片库" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PhotoCount}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                        </DockPanel>
                        <Button Content="＋ 打开文件夹" Command="{Binding OpenFolderCommand}" Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding RatingFilters}" SelectedIndex="{Binding RatingFilter}" Margin="0,0,0,10" />
                        <CheckBox Content="按星级分组" IsChecked="{Binding GroupRatings}" Margin="0,0,0,8" />
                        <CheckBox Content="评级后自动下一张" IsChecked="{Binding AutoAdvance}" Margin="0,0,0,12" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <controls:AdjustmentSlider Label="缩略图大小" Value="{Binding ThumbnailSize}" Minimum="45" Maximum="240" DefaultValue="100" />
                        <TextBlock Text="1–5  星级  ·  0  清除评级" Foreground="{StaticResource Muted}" FontSize="10" />
                    </StackPanel>
                    <ListBox x:Name="PhotoLibrary" ItemsSource="{Binding PhotosView}" SelectedItem="{Binding SelectedPhoto}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="PhotoLibrary">
                        <ListBox.GroupStyle>
                            <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#C8F28A" Margin="0,8" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="Loaded" Handler="PhotoCardLoaded" />
                                <Setter Property="Foreground" Value="#E7EBEF" />
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="#242A33" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#C8F28A" /><Setter TargetName="Card" Property="Background" Value="#2B3428" /></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><StackPanel>
                                <Grid Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0,0,0,8">
                                    <Border Background="#151A20" CornerRadius="3" />
                                    <TextBlock Text="{Binding Kind}" Foreground="#576476" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" />
                                <TextBlock Text="{Binding Stars}" Foreground="#C8F28A" FontSize="15" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Size}" Foreground="{StaticResource Muted}" FontSize="9" />
                            </StackPanel></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" /><RowDefinition Height="*" />
                    <RowDefinition Height="44" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="12,0">
                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox x:Name="ZoomNumber" Width="60" Padding="4,2" TextAlignment="Right" PreviewKeyDown="ZoomNumberKeyDown" LostFocus="ZoomNumberLostFocus" AutomationProperties.Name="缩放百分比" />
                        <TextBlock Text="%" Foreground="{StaticResource Muted}" Margin="4,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="10,0">
                    <controls:PhotoViewport x:Name="Viewport" Source="{Binding Preview}" Before="{Binding BeforePreview}"
                                            Composition="{Binding CropMode}" Crop="{Binding Crop}" PickGray="{Binding PickGray}"
                                            Comparison="{Binding ComparisonMode}" LogicalWidth="{Binding LogicalWidth}" LogicalHeight="{Binding LogicalHeight}"
                                            ToolTip="滚轮缩放 · 拖动平移 · 构图页拖动裁框和控制点 · Shift 拖动重新框选" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="光影，已就绪。" FontSize="25" HorizontalAlignment="Center" />
                        <TextBlock Text="拖入 JPG / NEF / ORF 照片" Foreground="{StaticResource Muted}" Margin="0,16" HorizontalAlignment="Center" />
                        <Button Content="打开照片" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="12,8,6,0" VerticalAlignment="Top">
                    <Button Content="适应" Click="FitImage" Padding="8,4" />
                    <Button Content="100%" Click="ActualSize" Padding="8,4" ToolTip="加载原尺寸细节" />
                    <ComboBox ItemsSource="{Binding ComparisonModes}" SelectedIndex="{Binding ComparisonMode}" Width="106" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RenderInfo}" FontSize="10" Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </WrapPanel>
                <Border Grid.Row="3" Background="#402621" Padding="12" Margin="10,0,10,10" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FFB3A1" />
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Line}" />
            <Grid Grid.Column="4" Background="{StaticResource Surface}">
                <Grid.RowDefinitions><RowDefinition x:Name="HistogramRow" Height="130" MinHeight="70" MaxHeight="300" /><RowDefinition Height="5" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="14,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="RGB 直方图" Foreground="{StaticResource Muted}" FontSize="10" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↶" Command="{Binding UndoCommand}" Padding="7,2" />
                            <Button Content="↷" Command="{Binding RedoCommand}" Padding="7,2" />
                            <Button Content="全部重置" Command="{Binding ResetCommand}" Padding="7,2" FontSize="10" />
                        </StackPanel>
                    </DockPanel>
                    <controls:HistogramView Values="{Binding Histogram}" />
                </DockPanel>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}" />
                <TabControl x:Name="ToolTabs" Grid.Row="2" SelectedIndex="{Binding SelectedToolTab}">
                    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="12,12" /></Style></TabControl.Resources>
                    <TabItem Header="编辑">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16" IsEnabled="{Binding HasImage}">
                                <Expander Header="光线"><StackPanel Margin="0,12,0,0">
                                    <controls:AdjustmentSlider Label="曝光 · EV" Value="{Binding Exposure}" Minimum="-10" Maximum="10" Step="0.1" />
                                    <controls:AdjustmentSlider Label="对比度" Value="{Binding Contrast}" />
                                    <controls:AdjustmentSlider Label="高光" Value="{Binding Highlights}" />
                                    <controls:AdjustmentSlider Label="阴影" Value="{Binding Shadows}" />
                                    <controls:AdjustmentSlider Label="中间调" Value="{Binding Midtones}" />
                                </StackPanel></Expander>
                                <Expander Header="白平衡与色彩"><StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="灰点取样 · 点击照片中的中性区域" IsChecked="{Binding PickGray}" Margin="0,0,0,14" />
                                    <controls:AdjustmentSlider Label="色温 · 冷 / 暖" Value="{Binding Temperature}" />
                                    <controls:AdjustmentSlider Label="色调 · 绿 / 洋红" Value="{Binding Tint}" />
                                    <controls:AdjustmentSlider Label="色相" Value="{Binding Hue}" Minimum="-360" Maximum="360" />
                                    <controls:AdjustmentSlider Label="饱和度" Value="{Binding Saturation}" />
                                </StackPanel></Expander>
                                <Expander Header="色调曲线"><StackPanel Margin="0,12,0,0">
                                    <ComboBox ItemsSource="{Binding CurveChannels}" SelectedIndex="{Binding CurveChannel}" />
                                    <controls:CurveEditor Curve="{Binding ActiveCurve, Mode=TwoWay}" />
                                    <Button Content="重置所有曲线" Click="ResetCurves" Margin="0,8,0,0" />
                                </StackPanel></Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="构图">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" IsEnabled="{Binding HasImage}">
                            <TextBlock Text="拖动边角缩放裁框，框内拖动移动。&#10;Shift 拖动重新框选；松开即生效。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20" Margin="0,0,0,16" />
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Button Content="↶ 90°" Command="{Binding RotateLeftCommand}" Padding="5,8" />
                                <Button Content="↷ 90°" Command="{Binding RotateRightCommand}" Padding="5,8" />
                                <Button Content="镜像" Command="{Binding FlipCommand}" Padding="5,8" />
                            </UniformGrid>
                            <controls:AdjustmentSlider Label="自由旋转 · °" Value="{Binding Straighten}" Minimum="-180" Maximum="180" Step="0.1" />
                            <TextBlock Text="旋转自动填满画布，避免黑边。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                            <WrapPanel Margin="0,0,0,16"><Button Content="1 : 1" Click="CropSquare" /><Button Content="3 : 2" Click="CropThreeTwo" /><Button Content="16 : 9" Click="CropWide" /></WrapPanel>
                            <controls:AdjustmentSlider Label="左侧 · %" Value="{Binding CropX}" Minimum="0" Maximum="99.5" />
                            <controls:AdjustmentSlider Label="顶部 · %" Value="{Binding CropY}" Minimum="0" Maximum="99.5" />
                            <controls:AdjustmentSlider Label="宽度 · %" Value="{Binding CropWidth}" Minimum="0.5" Maximum="100" DefaultValue="100" />
                            <controls:AdjustmentSlider Label="高度 · %" Value="{Binding CropHeight}" Minimum="0.5" Maximum="100" DefaultValue="100" />
                            <WrapPanel><Button Content="清除裁切" Command="{Binding ClearCropCommand}" /><Button Content="重置构图" Click="ResetComposition" /></WrapPanel>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="降噪">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" IsEnabled="{Binding HasImage}">
                            <TextBlock Text="细节与降噪" FontSize="18" Margin="0,0,0,12" />
                            <TextBlock Text="先在 100% 查看真实像素，再调整亮度和彩色降噪。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                            <Button Content="加载原尺寸 · 100%" Click="ActualSize" Margin="0,0,0,18" />
                            <controls:AdjustmentSlider Label="亮度噪点" Value="{Binding LuminanceDenoise}" Minimum="0" Maximum="100" />
                            <controls:AdjustmentSlider Label="彩色噪点" Value="{Binding ColorDenoise}" Minimum="0" Maximum="100" />
                            <controls:AdjustmentSlider Label="保留细节" Value="{Binding DenoiseDetail}" Minimum="0" Maximum="100" DefaultValue="50" />
                            <Button Content="重置降噪" Click="ResetDenoise" Margin="0,12,0,0" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="LUT">
                        <DockPanel Margin="14">
                            <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding HasImage}">
                                <TextBox Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索风格、分类或作者" Margin="0,0,0,10" />
                                <WrapPanel Margin="0,0,0,12"><Button Content="＋ 导入 .cube" Command="{Binding ImportLutCommand}" /><Button Content="移除" Command="{Binding ClearLutCommand}" /></WrapPanel>
                                <controls:AdjustmentSlider Label="LUT 强度" Value="{Binding LutStrength}" Minimum="0" Maximum="100" DefaultValue="100" IsEnabled="{Binding HasLut}" ToolTip="适用于 LUT；自然、暖胶片、黑白通过调整参数应用" />
                                <TextBlock Text="{Binding FilterName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Accent}" Margin="0,0,0,12" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock Text="{Binding SelectedFilter.Notes}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" />
                                <TextBlock Text="{Binding SelectedFilter.UnsupportedSummary}" TextWrapping="Wrap" Foreground="#D8BC83" FontSize="10" />
                                <TextBlock Text="{Binding SelectedFilter.License}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding FiltersView}" SelectedItem="{Binding SelectedFilter}" Background="#171D24" Foreground="#E7EBEF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,7"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Category}" Foreground="#96A2B0" FontSize="10" Margin="0,4,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="EXIF">
                        <DockPanel Margin="14">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding MetadataCount}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,14" />
                                <TextBox Text="{Binding MetadataSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索 EXIF" Margin="0,0,0,10" />
                                <Button Content="复制全部可见信息" Click="CopyMetadata" Margin="0,0,0,12" />
                            </StackPanel>
                            <ListView x:Name="MetadataList" ItemsSource="{Binding MetadataView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="4,8" /><Setter Property="Foreground" Value="#E7EBEF" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Group}" Foreground="#7B899A" FontSize="9" />
                                    <TextBlock Text="{Binding Name}" Foreground="#BAC5D1" FontSize="11" Margin="0,3,0,3" />
                                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" />
                                </StackPanel></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#1C222A" Padding="14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="60" Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Margin="10,0" />
                    <ProgressBar Width="60" Height="3" IsIndeterminate="True" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}" Margin="10,0" />
                    <ProgressBar Width="60" Height="3" IsIndeterminate="True" Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolVisibility}}" Margin="10,0" />
                    <Button Content="取消" Command="{Binding CancelCommand}" Padding="8,2" FontSize="10" />
                    <TextBlock Text="{Binding ImageInfo}" Foreground="#7E8B99" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="#A7B3C0" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
