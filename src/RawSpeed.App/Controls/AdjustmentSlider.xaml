<UserControl x:Class="RawSpeed.App.Controls.AdjustmentSlider" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,1,0,2">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="↺" Click="ResetClick" Padding="5,2" Margin="4,0,0,0" ToolTip="恢复默认值" AutomationProperties.Name="恢复默认值" />
      <TextBox x:Name="Number" DockPanel.Dock="Right" Width="65" Padding="4,2" TextAlignment="Right" FontFamily="Consolas" Text="{Binding Value, ElementName=Root, Mode=TwoWay, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" PreviewKeyDown="NumberKeyDown" LostFocus="NumberLostFocus" AutomationProperties.Name="{Binding Label, ElementName=Root}" />
      <TextBlock Text="{Binding Label, ElementName=Root}" Foreground="#BDC5CE" VerticalAlignment="Center" />
    </DockPanel>
    <Slider Value="{Binding Value, ElementName=Root, Mode=TwoWay}" Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}" SmallChange="{Binding Step, ElementName=Root}" AutomationProperties.Name="{Binding Label, ElementName=Root}" ToolTip="双击恢复默认值；数字可直接输入" PreviewMouseDoubleClick="ResetValue" />
  </StackPanel>
</UserControl>
