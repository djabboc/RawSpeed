<UserControl x:Class="RawSpeed.App.Controls.CurveEditor" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RawSpeed.App.Controls">
    <StackPanel>
        <local:CurveCanvas x:Name="Graph" Curve="{Binding Curve, ElementName=Root, Mode=TwoWay}" Height="220" Margin="0,8" />
        <TextBlock Text="单击加点 · 拖动调整 · 右键 / Delete 删点" Foreground="#9CA6B3" FontSize="10" Margin="0,0,0,8" />
        <local:AdjustmentSlider Label="输入" Value="{Binding Input, ElementName=Root}" Minimum="0" Maximum="255" />
        <local:AdjustmentSlider Label="输出" Value="{Binding Output, ElementName=Root}" Minimum="0" Maximum="255" />
        <Button Content="重置当前通道" Click="ResetCurve" />
    </StackPanel>
</UserControl>
