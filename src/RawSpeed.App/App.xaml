<Application x:Class="RawSpeed.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#181C22" />
    <SolidColorBrush x:Key="Panel" Color="#20252C" />
    <SolidColorBrush x:Key="Line" Color="#343B45" />
    <SolidColorBrush x:Key="Accent" Color="#C8F28A" />
    <SolidColorBrush x:Key="Muted" Color="#9CA6B3" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="#111419" /><Setter Property="Foreground" Value="#E7EBEF" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2B323B" /><Setter Property="Foreground" Value="#E7EBEF" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="#16220D" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10151B" /><Setter Property="Foreground" Value="#E7EBEF" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="Padding" Value="8,6" />
      <Setter Property="CaretBrush" Value="White" /><Setter Property="SelectionBrush" Value="#4E7044" />
    </Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,5,0,10" /><Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter Property="IsMoveToPointEnabled" Value="True" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9E1EA" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4" /><Setter Property="Foreground" Value="#16202B" /></Style>
    <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource Line}" /><Setter Property="Margin" Value="0,12" /></Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#E7EBEF" /><Setter Property="IsExpanded" Value="True" /><Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#9CA6B3" /><Setter Property="Padding" Value="22,12" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C8F28A" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8F28A" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
